# Firebase Web App Configuration (Project Settings -> Your apps -> SDK setup)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Firebase App Check
# Set to "true" to auto-generate a debug token in local dev, or paste a registered debug token UUID.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=true

# App Check site key for production builds (App Check -> Apps -> your web app).
# Without it, production builds skip App Check and an enforced AI Logic API rejects requests.
# VITE_FIREBASE_RECAPTCHA_SITE_KEY=your-site-key
# Provider for that key: Fraud Defense / reCAPTCHA Enterprise (default) or "recaptcha-v3" for a classic v3 key
# VITE_FIREBASE_APPCHECK_PROVIDER=recaptcha-enterprise

# Optional: Cloud Gemini model used for the price check (default: gemini-2.5-flash)
# VITE_GEMINI_MODEL=gemini-2.5-flash
